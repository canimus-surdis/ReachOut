<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: lit from above, with a soft shadow along the bottom edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_shadow" />
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/widget_bg" android:endColor="@color/widget_bg_bottom" />
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
        </shape>
    </item>
</layer-list>
