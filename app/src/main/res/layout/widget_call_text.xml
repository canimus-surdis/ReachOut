<?xml version="1.0" encoding="utf-8"?>
<!-- Widget: Who's up + Call/Text. One slim row. What's shown here is the preview in the widget list; the app fills in the real details. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_icon_tilted" />

    <!-- Two short lines: "Reach out to" / their name, or "ReachOut" / "Time to say hi" -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Reach out to"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Your next pick"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Call and Text (shown when someone is picked and has a number) -->
    <LinearLayout
        android:id="@+id/widget_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_icon_button"
            android:contentDescription="Call"
            android:padding="10dp"
            android:src="@drawable/ic_widget_call"
            android:tint="@color/widget_on_primary" />

        <ImageView
            android:id="@+id/widget_text"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_icon_button"
            android:contentDescription="Text"
            android:padding="10dp"
            android:src="@drawable/ic_widget_text"
            android:tint="@color/widget_on_primary" />
    </LinearLayout>

    <!-- Shown instead of Call and Text when nobody is picked -->
    <TextView
        android:id="@+id/widget_open"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:maxLines="1"
        android:minWidth="64dp"
        android:paddingHorizontal="14dp"
        android:text="Open"
        android:textColor="@color/widget_on_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
